@model IEnumerable<UlsaPhrases.Models.Phrase>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PhraseStatement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhraseAuthor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhraseDedication)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhraseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhraseContext)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PhraseStatement)
            </td>
            <td>
                @Html.DisplayFor(model => item.PhraseAuthor)
            </td>
            <td>
                @Html.DisplayFor(model => item.PhraseDedication)
            </td>
            <td>
                @Html.DisplayFor(model => item.PhraseDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.PhraseContext)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
